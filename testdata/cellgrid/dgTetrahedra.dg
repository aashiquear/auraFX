          0, 3, 2, 1,
          0, 0, 1, 1
        ]
      },

      {
        "name": "scalar2",
        "tuples": 2,
        "components": 4,
        "type": "double",
        "data": [
          0, 0, 0, 1,
          2, 2, 2, 1
        ]
      }
    ],
    "triangle sides of vtkDGTet": [
     {
        "name": "div1",
        "tuples": 2,
        "components": 4,
        "type": "double",
        "data": [
          0, 0, 0, 0,
          1, 1, 1, 1
        ]
     }
    ],
    "edge sides of vtkDGTet": [
