    "vtkDGTet": [
      {
        "name": "conn",
        "tuples": 2,
        "components": 4,
        "default_scalars": true,
        "type": "vtktypeint64",
        "data": [
          0,  1,  2,  3,
          1,  4,  2,  3
        ]
      },

      {
        "name": "scalar0",
        "tuples": 2,
        "components": 4,
        "type": "double",
        "data": [
